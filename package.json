{
  "name": "wedding-planner",
  "private": true,
  "version": "1.0.0",
  "description": "Private wedding planner for two",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "test": "npm run test -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "create-user": "npm run create-user -w server",
    "backup": "npm run backup -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "better-sqlite3@13.0.3": false,
    "esbuild@0.28.2": true
  }
}
