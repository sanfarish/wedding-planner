NODE_ENV=development

PORT=3000
HOST=127.0.0.1

# Paths are resolved relative to the server/ directory
DATABASE_PATH=./data/wedding.db
UPLOAD_DIR=./uploads

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-this-with-a-long-random-secret

# Used for the wedding countdown and "overdue" calculations
TZ=Asia/Jakarta
