# Copy to ~/wedding/.env on the VPS and `chmod 600` it.
# The image already sets NODE_ENV=production, HOST, PORT, DATABASE_PATH,
# SERVE_CLIENT, MIGRATE_ON_START and TRUST_PROXY; only the secret is required.

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-this-with-a-long-random-secret

# Optional overrides
# TZ=Asia/Jakarta
